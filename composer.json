{
  "name": "portfolio/yii2-app",
  "description": "Portfolio app on Yii2 + MySQL",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "^2.0",
    "yiisoft/yii2-composer": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "scripts": {
    "post-install-cmd": [
      "yii\\composer\\Installer::postCreateProject"
    ]
  },
  "config": {
    "process-timeout": 1800,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
